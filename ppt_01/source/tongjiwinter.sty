\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tongjiwinter}[2026/05/23 Tongji winter beamer template]

\RequirePackage{tikz}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{fontspec}
\RequirePackage{xeCJK}

\usetikzlibrary{calc}

\makeatletter
\providecommand{\tikzscope@linewidth}{0.4pt}
\providecommand{\pgfscope@linewidth}{0.4pt}
\providecommand{\pgfsys@end@save}{}
\makeatother

\mode<presentation>{
  \setbeamertemplate{navigation symbols}{}
  \setbeamertemplate{headline}{}
  \setbeamertemplate{footline}{}
  \setbeamertemplate{frametitle}{}
  \setbeamersize{text margin left=0pt,text margin right=0pt}
}

\definecolor{tjBlue}{HTML}{0078FF}
\definecolor{tjLightBlue}{HTML}{87C2F5}
\definecolor{tjDeepBlue}{HTML}{005B92}
\definecolor{tjTextBlack}{HTML}{050505}
\definecolor{tjTextGray}{HTML}{3A3A3A}
\definecolor{tjPatternGray}{HTML}{F3F3F3}

\IfFileExists{fonts/msyh.ttc}{
  \setCJKmainfont[Path=fonts/,BoldFont=msyhbd.ttc]{msyh.ttc}
  \setCJKsansfont[Path=fonts/,BoldFont=msyhbd.ttc]{msyh.ttc}
  \newCJKfontfamily\tjCJKTitle[Path=fonts/,BoldFont=msyhbd.ttc]{msyh.ttc}
}{
  \IfFontExistsTF{Noto Sans CJK SC}{
    \setCJKmainfont{Noto Sans CJK SC}
    \setCJKsansfont{Noto Sans CJK SC}
    \newCJKfontfamily\tjCJKTitle{Noto Sans CJK SC}
  }{
    \IfFontExistsTF{Source Han Sans SC}{
      \setCJKmainfont{Source Han Sans SC}
      \setCJKsansfont{Source Han Sans SC}
      \newCJKfontfamily\tjCJKTitle{Source Han Sans SC}
    }{
      \IfFontExistsTF{WenQuanYi Micro Hei}{
        \setCJKmainfont{WenQuanYi Micro Hei}
        \setCJKsansfont{WenQuanYi Micro Hei}
        \newCJKfontfamily\tjCJKTitle{WenQuanYi Micro Hei}
      }{
        \setCJKmainfont{FandolHei-Regular}
        \setCJKsansfont{FandolHei-Regular}
        \newCJKfontfamily\tjCJKTitle{FandolHei-Regular}
      }
    }
  }
}

\IfFileExists{fonts/msyhl.ttc}{
  \newCJKfontfamily\tjCJKLight[Path=fonts/]{msyhl.ttc}
}{
  \IfFontExistsTF{Noto Sans CJK SC}{
    \newCJKfontfamily\tjCJKLight{Noto Sans CJK SC}
  }{
    \IfFontExistsTF{Source Han Sans SC}{
      \newCJKfontfamily\tjCJKLight{Source Han Sans SC}
    }{
      \IfFontExistsTF{WenQuanYi Micro Hei}{
        \newCJKfontfamily\tjCJKLight{WenQuanYi Micro Hei}
      }{
        \newCJKfontfamily\tjCJKLight{FandolHei-Regular}
      }
    }
  }
}

\IfFileExists{fonts/seguibl.ttf}{
  \newfontfamily\tjLatinHeavy[Path=fonts/]{seguibl.ttf}
}{
  \IfFileExists{fonts/ariblk.ttf}{
    \newfontfamily\tjLatinHeavy[Path=fonts/]{ariblk.ttf}
  }{
    \newcommand{\tjLatinHeavy}{\sffamily\bfseries}
  }
}

\newenvironment{tjcanvas}{%
  \nointerlineskip%
  \begin{tikzpicture}[x=1cm,y=-1cm]
    \path[use as bounding box] (0,0) rectangle (16,9);
}{%
  \end{tikzpicture}%
}

\newcommand{\tjBaseBackground}{%
  \fill[white] (0,0) rectangle (16,9);
  \node[anchor=north west,inner sep=0pt] at (0,0)
    {\includegraphics[width=16cm,height=9cm]{assets/image1.png}};
  \fill[white!94] (0,0) rectangle (16,9);
}

\newcommand{\tjTopRule}{%
  \fill[tjLightBlue] (0,0) rectangle (16,0.07);
}

\newcommand{\tjCornerWaves}{%
  \fill[tjLightBlue]
    (0,7.1)
    .. controls (0.55,6.95) and (1.05,7.05) .. (1.28,7.55)
    .. controls (1.55,8.25) and (1.78,8.15) .. (2.55,8.45)
    .. controls (2.85,8.56) and (3.05,8.78) .. (3.08,9)
    -- (0,9) -- cycle;
  \fill[tjLightBlue]
    (16,7.1)
    .. controls (15.45,6.95) and (14.95,7.05) .. (14.72,7.55)
    .. controls (14.45,8.25) and (14.22,8.15) .. (13.45,8.45)
    .. controls (13.15,8.56) and (12.95,8.78) .. (12.92,9)
    -- (16,9) -- cycle;
  \fill[tjBlue!50!tjLightBlue] (0,8.58) rectangle (16,9);
}

\newcommand{\tjMarker}[2]{%
  \fill[tjLightBlue!60] (#1,#2) rectangle ++(0.42,0.42);
  \fill[tjBlue] ($(#1,#2)+(0.09,0.09)$) rectangle ++(0.25,0.25);
  \draw[tjBlue,line width=0.7pt] ($(#1,#2)+(0.21,0.42)$) -- ++(0,1.85);
}

\newcommand{\tjShadowNode}[4]{%
  \node[anchor=west,text=black!35,inner sep=0pt] at ($(#1,#2)+(0.045,0.045)$) {#4};
  \node[anchor=west,text=#3,inner sep=0pt] at (#1,#2) {#4};
}

\newcommand{\tjRightWaveImage}[1]{%
  \node[anchor=north east,inner sep=0pt] at (16.15,1.60)
    {\includegraphics[height=7.8cm]{#1}};
  \fill[tjLightBlue!82]
    (6.05,0)
    .. controls (5.78,0.58) and (6.05,1.48) .. (7.72,2.18)
    .. controls (8.88,2.66) and (8.65,3.92) .. (10.42,5.15)
    .. controls (11.18,5.67) and (12.28,5.35) .. (12.78,6.35)
    .. controls (13.30,7.35) and (12.38,7.78) .. (11.82,8.34)
    .. controls (11.55,8.63) and (11.45,8.82) .. (11.45,9)
    -- (16,9) -- (16,0) -- cycle;
  \fill[tjBlue!18!tjLightBlue]
    (6.05,0)
    .. controls (5.78,0.58) and (6.05,1.48) .. (7.72,2.18)
    .. controls (8.88,2.66) and (8.65,3.92) .. (10.42,5.15)
    .. controls (11.18,5.67) and (12.28,5.35) .. (12.78,6.35)
    .. controls (13.30,7.35) and (12.38,7.78) .. (11.82,8.34)
    .. controls (11.55,8.63) and (11.45,8.82) .. (11.45,9)
    -- (16,9) -- (16,0) -- cycle;
  \fill[tjDeepBlue!35!tjLightBlue] (11.45,7.35) rectangle (16,9);
}

\newcommand{\tjHexImage}[1]{%
  \node[anchor=south east,inner sep=0pt] at (16.05,8.98)
    {\includegraphics[height=7.15cm]{#1}};
  \fill[tjLightBlue!78]
    (7.99,6.18) -- (9.05,2.08) -- (15.45,2.08) -- (16,3.95) -- (16,9) -- (9.33,9) -- cycle;
  \fill[tjBlue!18!tjLightBlue]
    (7.99,6.18) -- (9.05,2.08) -- (15.45,2.08) -- (16,3.95) -- (16,9) -- (9.33,9) -- cycle;
}

\newcommand{\tongjicover}[4]{%
  \frame[plain]{%
    \centering
    {\tjCJKTitle\bfseries\fontsize{38}{44}\selectfont #1\par}
    \vspace{0.5cm}
    {\tjLatinHeavy\fontsize{45}{50}\selectfont #2\par}
    \vspace{0.8cm}
    {\tjCJKLight\fontsize{18}{23}\selectfont 汇报人：#3\par 日期：#4\par}
  }%
}

\newcommand{\tongjithankspage}[4]{%
  \frame[plain]{%
    \centering
    {\tjCJKTitle\bfseries\fontsize{36}{42}\selectfont\color{tjLightBlue} #1\par}
    \vspace{0.4cm}
    {\tjLatinHeavy\fontsize{32}{38}\selectfont\color{tjLightBlue} #2\par}
    \vspace{0.8cm}
    {\tjCJKLight\fontsize{18}{23}\selectfont 汇报人：#3\par 日期：#4\par}
  }%
}

\newcommand{\tongjicontents}[1]{%
  \frame[plain]{%
    \begin{tjcanvas}
      \tjBaseBackground
      \tjTopRule
      \tjCornerWaves
      \node[anchor=north,inner sep=0pt,text=black] at (8,0.82)
        {{\tjCJKTitle\bfseries\fontsize{29}{34}\selectfont 目录}};
      #1
    \end{tjcanvas}
  }%
}

\newcommand{\tongjicontentitem}[3]{%
  \ifnum#1<3
    \def\tjXNum{1.66}\def\tjXText{3.23}
  \else
    \def\tjXNum{8.72}\def\tjXText{10.29}
  \fi
  \ifodd#1
    \def\tjY{3.34}
  \else
    \def\tjY{5.65}
  \fi
  \node[anchor=west,inner sep=0pt,text=tjBlue] at (\tjXNum,\tjY)
    {{\tjLatinHeavy\fontsize{42}{46}\selectfont\contournum{#1}}};
  \fill[tjLightBlue] (\tjXText,{\tjY-0.52}) rectangle ++(0.47,0.03);
  \node[anchor=west,inner sep=0pt,text=black] at (\tjXText,{\tjY+0.06})
    {{\tjCJKTitle\bfseries\fontsize{21}{25}\selectfont #2}};
  \node[anchor=west,inner sep=0pt,text=tjTextGray] at (\tjXText,{\tjY+0.50})
    {{\tjCJKLight\fontsize{14}{18}\selectfont #3}};
}

\newcommand{\contournum}[1]{%
  \begingroup
  \ifnum#1=1 01\fi
  \ifnum#1=2 02\fi
  \ifnum#1=3 03\fi
  \ifnum#1=4 04\fi
  \endgroup
}

\newcommand{\tongjisectionpage}[3]{%
  \frame[plain]{%
    \begin{tjcanvas}
      \tjBaseBackground
      \tjTopRule
      \tjHexImage{#3}
      \node[anchor=west,inner sep=0pt,text=tjBlue] at (1.86,3.60)
        {{\tjLatinHeavy\fontsize{42}{46}\selectfont\contournum{#1}}};
      \tjShadowNode{1.86}{4.62}{tjBlue}{{\tjCJKTitle\bfseries\fontsize{35}{42}\selectfont #2}}
      \tjMarker{1.87}{5.20}
    \end{tjcanvas}
  }%
}
